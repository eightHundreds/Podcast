# Cloudflare R2（示例，本地上传脚本可选用）
# 在 Cloudflare Dashboard → R2 → Manage R2 API Tokens 创建
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=podcast-audio
# 形如 https://xxxxx.r2.cloudflarestorage.com
R2_ENDPOINT=
# 绑定的自定义域名或 r2.dev 公开 URL 前缀（写入 podcast.yaml 的 audio_base_url）
R2_PUBLIC_BASE_URL=https://audio.example.com/podcast/
